    "Energies = data['Energies'] # Energies: a vector of 3959 energy values at which the absorptions ˆx were measured\n",
    "Xhnew = data['Xhnew'] # Xhnew: a 332×3959 matrix of spectra taken at 33×33 pixels of an unknown specimen\n",
    "Zh = UndersamplingFeatures(Xh) # takes every 100 measurement of Xh, from feature 700-1700\n",
    "Zhnew = UndersamplingFeatures(Xhnew) # takes every 100th measurement of Xhnew, from feature 700-1700\n",
