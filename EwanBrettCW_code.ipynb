   "cell_type": "code",
   "execution_count": 71,
   "id": "58e62539-d066-4728-a202-99024847c2bd",
   "metadata": {},
   "outputs": [],
   "source": [
    "def ClusterFeaturesPredict(labels, Xh):\n",
    "    ''' Inputs: the ordered labels (kvec_ordered) generated from ClusterFeaturesFit() and a data matrix Xh.\n",
    "    Returns:  new matrix Zh where the ith column of Zh contains the average of those columns of Xh where labels = i, i = 0, . . . , K − 1'''\n",
    "    K = np.max(labels)+1 # number of clusters\n",
    "    no_samples = np.shape(Xh)[0] # number of sumples \n",
    "    Zh = np.zeros((no_samples,K)) # initialise Zh with the correct dimensions as a matrix of 0s\n",
    "    for k in range(K): # looping over all clusters\n",
    "        cluster_k = Xh[:,labels==k] # kth cluster is made up of the columns of Xh where our model predicts kth cluster\n",
    "        if np.size(cluster_k) == 0:\n",
    "            continue # avoiding any issues in the case that a cluster is empty\n",
    "        average_k = np.mean(cluster_k, axis = 1) # take the average of the columns in the kth cluster\n",
    "        Zh[:,k] = average_k # \n",
    "    return Zh"
   ]
  },
