    "thetastar_Z, num_iterations_Z, array_of_losses_Z = agd(Ztrain, Ytrain, Ztest, Ytest, Theta0, t=0.25, p=100, q=0.999, S=100000, eps=1e-8)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ddd2364b-5532-4cf9-a2c5-6deea95c6b7a",
   "metadata": {},
   "source": [
    "Defining a function which takes the softmax probabilities and gives us our vector of predictions:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 81,
   "id": "9170603c-b8cf-4c68-82d5-dbed5f78d7dc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def argmax(Yprob, eps = 1e-6):\n",
    "    '''inputs the probabilities from the softmax prediction, and outputs the labels based on which class has highest probability'''\n",
    "    Ypred = [] \n",
    "    for i in range(np.shape(Yprob)[0]):\n",
    "        max_y = np.max(Yprob[i,:]) \n",
    "        if Yprob[i,0] < max_y + eps and Yprob[i,0] > max_y -eps: # I have allowed a small region of acceptance rather than ==, so that there is robustness against rounding of floating point numbers\n",
    "            Ypred.append(1)\n",
    "        elif Yprob[i,1] < max_y + eps and Yprob[i,1] > max_y -eps:\n",
    "            Ypred.append(2)\n",
    "        else: \n",
    "            Ypred.append(3)\n",
    "        \n",
    "    Ypred = np.array(Ypred)\n",
    "    return Ypred"
   ]
  },
