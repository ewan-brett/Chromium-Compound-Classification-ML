   "outputs": [],
   "source": [
    "def agd(Xtrain, Ytrain, Xtest, Ytest, Theta0, t=1, p=100, q=0.999, S=1000, eps=1e-8):\n",
    "    '''input labelled training data and test data, initial parameter guess Theta0, \n",
    "    constant learning rate t=1 (specifies how far you move along gradient direction at each step),  p: iteration gap p ∈ N with the default value 100\n",
    "     q: loss reduction threshold q > 0 with the default value 0.999,  S: maximal number of iterations S > 0 with the default value 1000,  \n",
    "     eps=ε > 0: safety offset with the default value 10^−8\n",
    "     '''\n",
    "    theta_s = Theta0.copy() # initialising our theta parameter as a copy of Theta0, so that any changes made to theta_s affect theta_s only\n",
    "    thetastar = Theta0.copy() # optimal parameter, defined with a copy so that it is stored independently to theta_s\n",
    "    past_loss = [] # list of test losses for each iteration\n",
    "    best_loss = 100 # we will hold the best loss here, so that we can avoid recomputing it in each iteration for efficiency. Initiate it as any large value, here I have chosen 100.\n",
    "    for s in range(S):\n",
    "        iteration = s\n",
    "        loss_s = loss(Xtest, theta_s, Ytest)\n",
    "        if (s < p):\n",
    "            past_loss.append(loss_s) # if s < p we don't need to check the condiiton, however still need to store the loss in our list\n",
    "        else:\n",
    "            if (loss_s > q*past_loss[s-p]): # if our condition holds (loss has not significantly decreased in p iterations) we stop the loop\n",
    "                break\n",
    "            else:\n",
    "                past_loss.append(loss_s)\n",
    "        G = grad_loss(Xtrain, theta_s,Ytrain) # gradient of loss of training data with parameter theta_s, matrix with n+1 rows and M columns \n",
    "        v = np.mean(G**2) \n",
    "        if loss_s < best_loss:\n",
    "            thetastar = theta_s.copy() # if applicable we update our optimal parameter\n",
    "            best_loss = loss_s\n",
    "        theta_s -= t*(G/(np.sqrt(v)+eps)) # update our theta parameter\n",
    "    return thetastar, iteration, np.array(past_loss)"
   ]
  },
